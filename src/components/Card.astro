---
// One entry in Experience or Work. `bullets` accept **bold** spans, which is
// the only markup the copy needs — anything more belongs in a real content
// collection rather than a string.
interface Props {
  date: string;
  title: string;
  org?: string | null;
  orgHref?: string | null;
  summary: string;
  bullets?: readonly string[];
  tech?: readonly string[];
}
const { date, title, org, orgHref, summary, bullets = [], tech = [] } = Astro.props;

const bold = (s: string) =>
  s.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<li class="card">
  <div class="card-inner">
    <div class="card-date">{date}</div>
    <div>
      <h3 class="card-title">
        {orgHref
          ? <a class="inline-link" href={orgHref} target="_blank" rel="noopener noreferrer">{title}<span class="at"> · {org}</span></a>
          : <>{title}{org && <span class="at"> · {org}</span>}</>}
      </h3>
      <div class="card-body">
        <p set:html={bold(summary)} />
        {bullets.length > 0 && (
          <ul>
            {bullets.map((b) => <li set:html={bold(b)} />)}
          </ul>
        )}
        {tech.length > 0 && (
          <ul class="pills">
            {tech.map((t) => <li class="pill">{t}</li>)}
          </ul>
        )}
      </div>
    </div>
  </div>
</li>
